# Cung DB voi Spring Boot (Supabase). Dung session pooler (port 5432).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require

# Thu muc goc luu PDF (trung app.storage.upload-dir cua Spring). Worker tu choi doc tep nam ngoai thu muc nay.
UPLOAD_ROOT=../uploads/digital-copies

# Du lieu worker: data/tfidf (mo hinh TF-IDF + inverted file), data/copies (dong tu + vi tri tung ban so)
DATA_DIR=./data

# Tu dien dong nghia (mac dinh app/synonyms.txt)
# SYNONYMS_FILE=./app/synonyms.txt

# So chunk ung vien truoc khi gop chunk goi nhau; do dai trich doan (so tu)
SEARCH_CANDIDATE_CHUNKS=300
SNIPPET_WORDS=50

# Chia tai lieu thanh cac phan (so tu) khi khong co search_vector_configs dang active
DEFAULT_CHUNK_SIZE=200
DEFAULT_OVERLAP=40

# Cat tia tu dien (muc 1.4)
TFIDF_MIN_DF=3
TFIDF_MAX_DF=0.5
TFIDF_MAX_FEATURES=200000

# Ty le trang co chu toi thieu de coi la INDEXED (thap hon => LOW_QUALITY, thuong la PDF scan)
LOW_QUALITY_THRESHOLD=0.5
